[gd_scene format=3 uid="uid://cmaingame001letterlogic"]

[ext_resource type="Script" path="res://scripts/main_game.gd" id="1_main_game_script"]
[ext_resource type="PackedScene" path="res://scenes/game_board.tscn" id="2_game_board"]
[ext_resource type="PackedScene" path="res://scenes/keyboard.tscn" id="3_keyboard"]

[node name="MainGame" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_main_game_script")

[node name="VBoxContainer" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 16.0
offset_top = 16.0
offset_right = -16.0
offset_bottom = -16.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 12

[node name="Header" type="HBoxContainer" parent="VBoxContainer"]
custom_minimum_size = Vector2(0, 48)
layout_mode = 2

[node name="BackButton" type="Button" parent="VBoxContainer/Header"]
custom_minimum_size = Vector2(48, 48)
layout_mode = 2
theme_override_font_sizes/font_size = 22
text = "←"

[node name="TitleBox" type="VBoxContainer" parent="VBoxContainer/Header"]
layout_mode = 2
size_flags_horizontal = 3
alignment = 1

[node name="TitleLabel" type="Label" parent="VBoxContainer/Header/TitleBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "LETTERLOGIC"
horizontal_alignment = 1

[node name="ModeLabel" type="Label" parent="VBoxContainer/Header/TitleBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.65, 0.65, 0.65, 1)
theme_override_font_sizes/font_size = 14
text = "CONTINUOUS PLAY"
horizontal_alignment = 1

[node name="Spacer" type="Control" parent="VBoxContainer/Header"]
custom_minimum_size = Vector2(48, 48)
layout_mode = 2

[node name="BoardArea" type="Control" parent="VBoxContainer"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="GameBoard" parent="VBoxContainer/BoardArea" instance=ExtResource("2_game_board")]
layout_mode = 1

[node name="KeyboardArea" type="Control" parent="VBoxContainer"]
custom_minimum_size = Vector2(0, 210)
layout_mode = 2

[node name="Keyboard" parent="VBoxContainer/KeyboardArea" instance=ExtResource("3_keyboard")]
layout_mode = 1

[node name="ToastOverlay" type="CenterContainer" parent="."]
visible = false
layout_mode = 1
anchors_preset = 10
anchor_right = 1.0
offset_top = 80.0
offset_bottom = 140.0
grow_horizontal = 2

[node name="ToastPanel" type="PanelContainer" parent="ToastOverlay"]
layout_mode = 2

[node name="ToastLabel" type="Label" parent="ToastOverlay/ToastPanel"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_font_sizes/font_size = 18
text = "Not in word list"
horizontal_alignment = 1

[node name="ToastTimer" type="Timer" parent="ToastOverlay"]
one_shot = true

[node name="GameOverModal" type="ColorRect" parent="."]
visible = false
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0, 0, 0, 0.7)

[node name="Panel" type="PanelContainer" parent="GameOverModal"]
custom_minimum_size = Vector2(360, 240)
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -180.0
offset_top = -120.0
offset_right = 180.0
offset_bottom = 120.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBox" type="VBoxContainer" parent="GameOverModal/Panel"]
layout_mode = 2
theme_override_constants/separation = 16
alignment = 1

[node name="TitleLabel" type="Label" parent="GameOverModal/Panel/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 28
text = "Splendid!"
horizontal_alignment = 1

[node name="MessageLabel" type="Label" parent="GameOverModal/Panel/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "You found the word in 3/6 guesses."
horizontal_alignment = 1
autowrap_mode = 2

[node name="ButtonContainer" type="VBoxContainer" parent="GameOverModal/Panel/VBox"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="NextWordButton" type="Button" parent="GameOverModal/Panel/VBox/ButtonContainer"]
custom_minimum_size = Vector2(0, 48)
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "Next Word"

[node name="ShareButton" type="Button" parent="GameOverModal/Panel/VBox/ButtonContainer"]
visible = false
custom_minimum_size = Vector2(0, 48)
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "Share Results"

[node name="MenuButton" type="Button" parent="GameOverModal/Panel/VBox/ButtonContainer"]
custom_minimum_size = Vector2(0, 44)
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "Main Menu"

[connection signal="pressed" from="VBoxContainer/Header/BackButton" to="." method="_on_back_to_menu_pressed"]
[connection signal="timeout" from="ToastOverlay/ToastTimer" to="." method="_on_toast_timer_timeout"]
[connection signal="pressed" from="GameOverModal/Panel/VBox/ButtonContainer/NextWordButton" to="." method="_on_next_word_pressed"]
[connection signal="pressed" from="GameOverModal/Panel/VBox/ButtonContainer/ShareButton" to="." method="_on_share_pressed"]
[connection signal="pressed" from="GameOverModal/Panel/VBox/ButtonContainer/MenuButton" to="." method="_on_back_to_menu_pressed"]
