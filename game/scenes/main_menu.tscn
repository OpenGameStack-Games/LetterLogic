[node name="VBox" type="VBoxContainer" parent="HowToPlayModal/MarginContainer/Panel"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="ModalTitle" type="Label" parent="HowToPlayModal/MarginContainer/Panel/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 28
text = "HOW TO PLAY"
horizontal_alignment = 1

[node name="RulesText" type="RichTextLabel" parent="HowToPlayModal/MarginContainer/Panel/VBox"]
layout_mode = 2
size_flags_vertical = 3
bbcode_enabled = true
text = "[b]Guess the secret word in 6 attempts.[/b]

• Each guess must be a valid 5-letter word.
• [color=#ffcc00][b]Special Rule:[/b][/color] Words [b]NEVER contain duplicate letters[/b]! Keys you've already typed in the current row will be temporarily disabled.

[b]Tile Colors:[/b]
[color=#538d4e]🟩 GREEN[/color] - Letter is in the word and in the correct spot.
[color=#b59f3b]🟨 YELLOW[/color] - Letter is in the word but wrong spot.
[color=#b53b3b]🟥 RED[/color] - Letter is not in the word.

[b]Modes:[/b]
• [b]Daily Challenge:[/b] One synchronized word per day (resets at midnight UTC).
• [b]Continuous Play:[/b] Play as many words as you like!"
scroll_active = true

[node name="CloseButton" type="Button" parent="HowToPlayModal/MarginContainer/Panel/VBox"]
custom_minimum_size = Vector2(0, 48)
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "Got It!"

[node name="StatsScreen" parent="." instance=ExtResource("2_stats_screen")]
visible = false
layout_mode = 1

