[gd_scene format=3 uid="uid://cmainmenu001letterlogic"]

[ext_resource type="Script" path="res://scripts/main_menu.gd" id="1_menu_script"]

[node name="MainMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
